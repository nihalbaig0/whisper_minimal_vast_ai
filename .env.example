# Copy to .env in the project root (Compose loads it automatically).
# Public hostnames (DNS A records should point to your server).
WHISPER_HOST=whisper.example.com
TRAEFIK_HOST=traefik.whisper.example.com

# Cloudflare: API token with Zone.DNS:Edit + Zone.Zone:Read on your zone (see README).
CF_DNS_API_TOKEN=your_cloudflare_api_token

# Let's Encrypt contact + Traefik dashboard basic auth (APR1 hash for HASHED_PASSWORD).
EMAIL=admin@example.com
USERNAME=admin
HASHED_PASSWORD=changeme
